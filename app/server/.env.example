# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database
# Default Docker compose password is "change-me-local-only" unless POSTGRES_PASSWORD is set.
DATABASE_URL=postgresql://todo_app:change-me-local-only@localhost:5432/todo_app

# Session
SESSION_COOKIE_NAME=todo_app_session
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=30
TEST_AUTH_ENABLED=false

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Email via SMTP/Nodemailer
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Todo App <no-reply@example.com>"

# Reminders
REMINDERS_ENABLED=false
REMINDER_CRON=*/1 * * * *
REMINDER_MAX_ATTEMPTS=3

# Optional Stitch design integration - never expose to client
STITCH_API_KEY=
